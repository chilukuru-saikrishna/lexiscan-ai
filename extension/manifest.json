{
  "manifest_version": 3,
  "name": "Lexiscan AI — Contract Intelligence",
  "version": "1.0",
  "description": "Intelligent contract risk scanning, playbook benchmarking, and automated redlining.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan Clause with Lexiscan AI"
  }
}